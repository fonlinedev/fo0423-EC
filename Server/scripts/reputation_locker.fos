#include "_macros.fos"
#include "factions_h.fos"
#include "npc_roles_h.fos"
#include "npc_common_h.fos"
import bool HandleLocker(Critter& cr, Map@ map, Item& locker, bool disregardKey) from "lockers";

// Loot Category Definitions (Set faction in Val0, category in Val1)
#define CAT_DEFAULT        0
#define CAT_BOOKS_DRUGS    1
#define CAT_WEAPONS        2
#define CAT_ARMOR          3
#define CAT_TIER1          4

// Initialization function assigned to containers in the Mapper
void _OutpostLocker(Item& item, bool firstTime)
{
    item.SetEvent(ITEM_EVENT_SKILL, "_OutpostLockerSkill");
    item.SetEvent(ITEM_EVENT_USE_ON_ME, "_OutpostLockerUseOnMe");
    
    uint[] values = { item.Id };
    
    CreateTimeEvent(__FullSecond + REAL_SECOND(3600), "e_RespawnLoot", values, true);
	FillContainerWithRandomLoot(item);	
	if(item.LockerId != 0)
	{
		item.LockerCondition = 1; // Force lock after generating loot
	}

}

void OutpostIssueWarning(Item& item)
{
	uint faction = item.Val0;
    array<Critter@> crits;
    uint            n = GetNearFactionGuards(GetMap(item.MapId), item.HexX, item.HexY, 10, faction, crits);
    for(uint i = 0; i < n; i++)
        if(crits[i].Stat[ST_NPC_ROLE] == ROLE_BOS_OUTPOST_GUARD)
            crits[i].Say(SAY_NORM_ON_HEAD, "Stop right there!");
}

void OutpostAttack(Item& item, Critter& crit)
{
	uint faction = item.Val0;
    array<Critter@> crits;
    uint            n = GetNearFactionGuards(GetMap(item.MapId), item.HexX, item.HexY, 10, faction, crits);
    for(uint i = 0; i < n; i++)
        AttackCritter(crits[i], crit);
}

bool _OutpostLockerUseOnMe(Item& item, Critter& crit, Item@ usedItem)
{
	uint faction = item.Val0;
    uint category = item.Val1;
	uint reputation = item.Val2;
	
    if(crit.Stat[ST_TEAM_ID] == faction)
    {
        return false;
    }

    if(crit.ReputationBase[faction] < 800) 
    {
        crit.Say(SAY_NETMSG, "Not enough reputation for the locker. You had been warned.");
        OutpostIssueWarning(item);
    }   
    return false;
}

bool _OutpostLockerSkill(Item& item, Critter& cr, int skill)
{    
	uint faction = item.Val0;
    uint category = item.Val1;
	uint reputation = item.Val2;
		
    if(item.LockerId == 0)
    {
        item.LockerId = Random(0, 0x7FFFFFFF);
        item.LockerComplexity = 10;
    }

    if(cr.Stat[ST_TEAM_ID] == int(faction))
    {        
        return HandleLocker(cr, GetMap(item.MapId), item, true);
    }

    if(skill == -1)
    {        
        if(cr.ReputationBase[faction] < int(reputation))
        {            
            OutpostIssueWarning(item);
            return true; 
        }
        else
        {
            cr.Say(SAY_NETMSG, "You are allowed to use the faction locker " + cr.ReputationBase[faction] + ", minimum is " + reputation);
        }
    }
    
    if(skill == SK_LOCKPICK) 
    {
        if(cr.ReputationBase[faction] < int(reputation))
        {
            cr.Say(SAY_NETMSG, "Reputation is below threshold. You lost 100 reputation.");
            cr.ReputationBase[faction] -= 100;            
            OutpostAttack(item, cr);
            return true; 
        }
    }
    
    return false;
}

// The time loop executed by the engine every 60 minutes
uint e_RespawnLoot(uint[]@ values)
{
    if(values is null || values.length() == 0) return 0;

    uint containerId = values[0];
    Item@ container = GetItem(containerId);
    
    if(valid(container))
    {
        ClearOutpostContainer(container);
        FillContainerWithRandomLoot(container);
    }
    else
    {
        // Container no longer exists, stop the event loop
        return 0; 
    }
    
    // Returning 3600 tells the engine to run this event again in 1 hour
    return 3600;
}

void FillContainerWithRandomLoot(Item& container)
{
    uint faction = container.Val0;
    uint category = container.Val1;    
    if(faction == FACTION_BOS) 
    {	
        if(category == CAT_BOOKS_DRUGS)
        {
            if(Random(1, 100) <= 75) container.AddItem(40, Random(1, 10), 0);   // Stimpak
            if(Random(1, 100) <= 40) container.AddItem(144, Random(1, 5), 0);  // Super Stimpak
            if(Random(1, 100) <= 50) container.AddItem(87, Random(1, 2), 0);   // Buffout
            if(Random(1, 100) <= 35) container.AddItem(110, 1, 0);             // Psycho
            if(Random(1, 100) <= 45) container.AddItem(109, Random(1, 3), 0);  // Rad-X                
            if(Random(1, 100) <= 30) container.AddItem(48, 1, 0);              // RadAway 
            if(Random(1, 100) <= 25) container.AddItem(102, 1, 0);             // Guns and Bullets
            if(Random(1, 100) <= 10) container.AddItem(86, 1, 0);              // Scout Handbook
            if(Random(1, 100) <= 20) container.AddItem(76, 1, 0);              // Deans Electronics
            if(Random(1, 100) <= 20) container.AddItem(80, 1, 0);              // First Aid Book
            if(Random(1, 100) <= 15) container.AddItem(73, 1, 0);              // Big Book of Science                
        }
        else if(category == CAT_WEAPONS) 
        {
            int weaponRoll = Random(1, 4);
            if(weaponRoll == 1)
            {
                container.AddItem(8, 1, 0);                                    // 10mm Pistol
                container.AddItem(29, Random(2, 5) * 10, 0);                  // 10mm JHP
            }
            else if(weaponRoll == 2)
            {
                container.AddItem(10, 1, 0);                                   // Hunting Rifle
                container.AddItem(34, Random(1, 3) * 10, 0);                  // .223 FMJ
            }
            else if(weaponRoll == 3)
            {
                container.AddItem(94, 1, 0);                                   // Shotgun
                container.AddItem(95, Random(2, 4) * 6, 0);                    // Shotgun Shells
            }
            else if(weaponRoll == 4)
            {
                container.AddItem(23, 1, 0);                                   // Assault Rifle
                container.AddItem(35, Random(3, 5) * 30, 0);                   // 5mm JHP
            }
            
            if(Random(1, 100) <= 15) container.AddItem(15, 1, 0);              // Plasma Rifle
            if(Random(1, 100) <= 10) container.AddItem(12, 1, 0);              // Minigun
        }
        else if(category == CAT_ARMOR) 
        {                
            if(Random(1, 100) <= 15) container.AddItem(2, 1, 0);               // Metal Armor
            if(Random(1, 100) <= 15) container.AddItem(17, 1, 0);              // Combat Armor
            if(Random(1, 100) <= 5)  container.AddItem(725, 1, 0); 
            if(Random(1, 100) <= 2)  container.AddItem(726, 1, 0); 
            if(Random(1, 100) <= 3)  container.AddItem(727, 1, 0); 
            if(Random(1, 100) <= 20) container.AddItem(728, 1, 0); 
            if(Random(1, 100) <= 25) container.AddItem(729, 1, 0); 
            if(Random(1, 100) <= 20) container.AddItem(730, 1, 0); 
            if(Random(1, 100) <= 3)  container.AddItem(731, 1, 0); 
            if(Random(1, 100) <= 25) container.AddItem(732, 1, 0); 
            if(Random(1, 100) <= 8)  container.AddItem(733, 1, 0); 
            if(Random(1, 100) <= 2)  container.AddItem(239, 1, 0);                
        }
        else if(category == CAT_TIER1) 
        {
            
        } 
        else 
        {
            if(Random(1, 100) <= 23) container.AddItem(47, 1, 0);             // First Aid Kit
            if(Random(1, 100) <= 45) container.AddItem(49, 1, 0);             // Antidote
            if(Random(1, 100) <= 55) container.AddItem(53, 1, 0);             // Mentats
            if(Random(1, 100) <= 60) container.AddItem(535, Random(2, 6), 0);  // Gunpowder
            if(Random(1, 100) <= 45) container.AddItem(1801, Random(5, 30), 0); // Electronic Parts
            if(Random(1, 100) <= 30) container.AddItem(9632, Random(2, 10), 0); // Fibre 2
            if(Random(1, 100) <= 35) container.AddItem(9629, Random(1, 10), 0); // Chemicals
        }
    } else {
		Log("WARNING: Faction not defined! Container Val0 is " + faction + ", container is empty.");
	}
}

void ClearOutpostContainer(Item& container)
{
    Item@[] items;
    uint count = container.GetItems(0, items);
    for(uint i = 0; i < count; i++)
    {
        DeleteItem(items[i]);
    }

    if(container.LockerId != 0)
    {
        container.LockerCondition = 1; 
    }
}