{
    Log("Initializing patrol routes");

    // Todo: Remake this not to have id=position in array+1

    // ===================================
    // Junktown routes #1
    // ===================================
    ADD_ROUTE(junktown_gate_patrol, MAP_Junktown, AddNode(123, 123, 1, 5000).AddNode(123, 123, 3, 5000));       // id 1

