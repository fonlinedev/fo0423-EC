#include "_macros.fos"
#include "_vars.fos"
#include "_dialogs.fos"
#include "_maps.fos"
#include "_defines.fos"
#include "ITEMPID.H"

void critter_init(Critter& npc, bool firstTime)
{	

	npc.StatBase[ST_DIALOG_ID] = DIALOG_aradesh1;		
	npc.SetEvent(CRITTER_EVENT_SHOW_CRITTER, "_OnShowCritter");
}

void _OnShowCritter(Critter& npc, Critter& critter)
{
	if(!critter.IsPlayer()) {
		Log("Not a valid player");
		return;
	}
	Log("player showing");
	GameVar@  questVar = GetLocalVar(LVAR_q_shady_radscorpions, critter.Id);
	
	Log("Quest var value" + questVar.GetValue());
	if (questVar.GetValue() == 0) {
		Log("showing dialog 1");
		npc.StatBase[ST_DIALOG_ID] = DIALOG_aradesh1;
	} else if (questVar.GetValue() == 1) {
		Log("showing dialog 2");
		npc.StatBase[ST_DIALOG_ID] = DIALOG_aradesh2;
	} else {
		Log("showing default dialog");
		npc.StatBase[ST_DIALOG_ID] = DIALOG_aradesh1;
	}    
}
