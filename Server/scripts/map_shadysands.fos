import bool   IsCompanion(Critter& follower) from "follower";

#define DIALOG_RAZLO_WIFE  (4024)

// items initialized once.
uint[] LOCKER_PROTECTED_ITEMS = { PID_223_FMJ, PID_SCOUT_HANDBOOK, PID_DOCTORS_BAG, PID_FIRST_AID_BOOK, PID_FIRST_AID_KIT };

#define ARADESH_PID (206)
#define GUARD_PID (67)
#define TANDI_PID (68)

enum TandiQuestState
{
    TANDI_NOT_STARTED   = 0,
    TANDI_MISSING       = 1,
    TANDI_SEARCHING     = 2,
    TANDI_FOUND         = 3,
    TANDI_RESCUED       = 4,
    TANDI_COMPLETED     = 5,
    TANDI_DEAD          = 7
};

class LockerLoot
{
    uint Pid;
    uint Count;

    LockerLoot(uint pid, uint count)
    {
        Pid = pid;
        Count = count;
    }
};

void map_init(Map& map, bool firstTime)
{
    uint respawnTime = 1; // 1 hour loop
    uint[] values = { map.GetProtoId() };    
    CreateTimeEvent(__FullSecond + REAL_HOUR(respawnTime), "e_RespawnLoot", values, false);
    map.SetEvent(MAP_EVENT_IN_CRITTER, "_CritterIn");
    if(firstTime)
    {
        //map.SetTurnBasedAvailability(true);
        //initLockersOnce(map.GetProtoId());
    }
}
// Called when the player leave the v13 cave.
void RevealShadySands(Critter& player)
{
    GameVar@ qshadySands = GetLocalVar(LVAR_q_shady_sands, player.Id);
    if(qshadySands.GetValue() > 0)
    {
        return;
    }

    uint16 worldX = 1724;
    uint16 worldY = 1368;
        
    array<Critter@> critters = { player };
    uint            locId = CreateLocation(LOCATION_ShadySands, worldX, worldY, critters);
    Location@ loc = GetLocation(locId); 
    if (!valid(loc)) {
        Log("error getting location based on id "+locId);
        return;
    }
    SetRootMapData(loc, MAP_DATA_OWNER, player.Id);
    SetTurnBasedAvailability(loc);  

    GameVar@ qShadySandsLocid = GetLocalVar(LVAR_q_shady_sands_loc_id, player.Id);
    qShadySandsLocid = locId;

    qshadySands = 1;
    Map@     shadyW = loc.GetMapByIndex(0);
    if (!valid(shadyW)) {
        Log("shadyW failed to get reference ");
        return;
    }
    Map@     shadyE = loc.GetMapByIndex(1);
    if (!valid(shadyE)) {
        Log("shadyE failed to get reference ");
        return;
    }

    initLockersOnce(shadyW);
    initLockersOnce(shadyE);
    SetQuestGarbager(0, player.Id, locId, LVAR_q_shady_sands, TANDI_DEAD);
}

// Initialize npcs and Tandi
void _CritterIn(Map& map, Critter& cr)
{
    Critter@ player = null;
    if(cr.IsPlayer() || _IsRealPlayer(cr)) {
		@player = cr;
		Log("Real player found on Shady Sands.");
	} else {
		Log("No real player found in Shady Sands, skipping NPC state update.");		
		return;		
	}

    if(!valid(map))
    {
        Log("Shady Sands map not found.");
        return;
    }

    array<Critter@> critters;
    uint critterCount = map.GetCritters(0, FIND_ALL, critters);

	bool aradeshDone = false;
    bool tandiDone = false;
	for(uint i = 0; i < critterCount; i++)
    {
        Critter@ cr = critters[i];

        if(!valid(cr))
            continue;

        if(cr.IsDead())
            continue;

        if(!cr.IsNpc())
            continue;

        if(IsCompanion(cr))
            continue;

        uint pId = cr.GetProtoId();

        if(pId == ARADESH_PID)
        {
            Log("Aradesh found.");
            aradeshDone = updateAradesh(cr, player);            
        }
        else if(pId == TANDI_PID)
        {
            Log("Tandi found.");
            tandiDone = updateTandiVisibility(cr, player);
        }
    }
    if(aradeshDone && tandiDone)
    {
        Log("Aradesh and Tandi updates complete.");
        return;
    }
}

bool updateAradesh(Critter@ npc, Critter@ player)
{
    if(!valid(npc))
    {
        Log("updateAradesh: invalid Aradesh.");
        return false;
    }

    if(!valid(player))
    {
        Log("updateAradesh: invalid player.");
        return false;
    }

    GameVar@ questVar1 = GetLocalVar(
        LVAR_q_shady_radscorpions,
        player.Id
    );

    GameVar@ questVar2 = GetLocalVar(
        LVAR_q_shady_antidote,
        player.Id
    );

    GameVar@ questVar3 = GetLocalVar(
        LVAR_q_shady_tandi,
        player.Id
    );

    if(!valid(questVar1) || !valid(questVar2) || !valid(questVar3))
    {
        Log("updateAradesh: quest variables not found.");
        return false;
    }

    uint radscorpionState = questVar1.GetValue();
    uint antidoteState    = questVar2.GetValue();
    uint tandiState       = questVar3.GetValue();

    // -------------------------------------------------
    // Radscorpion quest not started
    // -------------------------------------------------

    if(radscorpionState == 0 || radscorpionState == 1)
    {
        Log("Player did not started or finished the quest of radscorpions.");
        
        return false;
    }

    // -------------------------------------------------
    // Both prerequisite quests finished
    // Player can now start Tandi quest
    // -------------------------------------------------

    if(radscorpionState == 3 && antidoteState == 1)
    {
        Log("Player completed the prerequisites for the Tandi quest.");

        // Tandi quest has not started yet.
        if(tandiState == 0)
        {
            Log("Player can start the quest for Tandi.");

            npc.StatBase[ST_DIALOG_ID] = DIALOG_aradesh3;
            return true;
        }

        // Tandi quest is already active.
        if(tandiState == 1 ||
           tandiState == 2 ||
           tandiState == 3 ||
           tandiState == 4)
        {
            Log("Tandi quest is currently in progress.");

            npc.StatBase[ST_DIALOG_ID] = DIALOG_aradesh3;
            return true;
        }

        // Tandi quest completed.
        if(tandiState == 5)
        {
            Log("Tandi quest is completed.");

            npc.StatBase[ST_DIALOG_ID] = DIALOG_aradesh3;
            return true;
        }
    }

    // -------------------------------------------------
    // Fallback
    // -------------------------------------------------

    Log("Aradesh: no special quest state.");

    npc.StatBase[ST_DIALOG_ID] = DIALOG_aradesh1;
    return false;
}

bool updateTandiVisibility(Critter@ npc, Critter@ player)
{
    if(!valid(npc))
    {
        Log("updateTandiVisibility: invalid critter.");
        return false;
    }

    if(!valid(player))
    {
        Log("updateTandiVisibility: invalid player.");
        return false;
    }

    GameVar@ questVar1 = GetLocalVar(
        LVAR_q_shady_radscorpions,
        player.Id
    );

    GameVar@ questVar2 = GetLocalVar(
        LVAR_q_shady_antidote,
        player.Id
    );

    GameVar@ questVar3 = GetLocalVar(
        LVAR_q_shady_tandi,
        player.Id
    );

    if(!valid(questVar1) ||
       !valid(questVar2) ||
       !valid(questVar3))
    {
        Log("updateTandiVisibility: quest variables not found.");
        return false;
    }

    uint radscorpionState = uint(questVar1.GetValue());
    uint antidoteState    = uint(questVar2.GetValue());
    uint tandiState       = uint(questVar3.GetValue());

    // -------------------------------------------------
    // Tandi disappears when the prerequisites are done
    // and her quest has not been completed.
    // -------------------------------------------------

    if(radscorpionState == 3 &&
       antidoteState == 1 &&
       tandiState != uint(TANDI_RESCUED) &&
       tandiState != uint(TANDI_COMPLETED))
    {
        Log("Tandi is unavailable. Removing her from Shady Sands.");

        DeleteNpc(npc);
        return true;
    }

    return false;
}


Critter@ findSeth() {
    Log("checking npc states in the map.");

    Map@ map = GetMapByPid(MAP_ShadyWest, 0);

    if(!valid(map))
    {
        Log("Shady Sands map not found.");
        return null;
    }

    array<Critter@> critters;
    uint critterCount = map.GetCritters(0, FIND_ALL, critters);

    for(uint i = 0; i < critterCount; i++)
    {
        Critter@ cr = critters[i];

        if(!valid(cr))
            continue;

        if(cr.IsDead())
            continue;

        if(!cr.IsNpc())
            continue;

        if(IsCompanion(cr))
            continue;

        uint pId = cr.GetProtoId();

        if(pId == GUARD_PID)
        {
            if(cr.HexX == 108 && cr.HexY == 70)
            {
                return cr;
            }
        }
    }

    return null;
}

uint e_RespawnLoot(uint[]@ values)
{
    if(values is null || values.length() == 0) return 0;
    uint mapId = values[0];
    respawnLockers(mapId);
    return REAL_HOUR(1);
}

void r_RevealRaidersCamp(Critter& player, Critter@ npc)
{
    int loc = CreateLocation(LOCATION_Raiderscamp, 1774, 1476, null);
    Log("Raiders CreateLocation returned = " + loc);
    if(loc == 0)
    {
        Log("Failed to create Raiders Camp.");
        return;
    }

    GameVar@ locidv = GetLocalVar(LVAR_q_shady_raiders_locid, player.Id);
    locidv = loc;

    Location@ location = GetLocation(LOCATION_Raiderscamp);

    if(!valid(location))
    {
        Log("Raiders Camp location not found: " + loc);
        return;
    }

    Log("Raiders Camp location id " + loc + " actual location id " + location.Id);

    Map@ map = location.GetMapByIndex(0);

    if(!valid(map))
    {
        Log("Raiders Camp map not found.");
        return;
    }

    SetTurnBasedAvailability(location);

    map.SetData(MAP_DATA_CAMP_OWNER, player.Id);

    SetQuestGarbager(0, player.Id, loc, LVAR_q_shady_tandi, 5);

    // Do this LAST, like the known-working function.
    player.SetKnownLoc(false, LOCATION_Raiderscamp);

    setTandiQuestVal(player, 2);

    player.Say(SAY_NETMSG, "The raiders camp has been marked in your map.");
}

// First init the lockers, only run once.
void initLockersOnce(Map@ map)
{    
    if(!valid(map))
    {
        Log("initLockersOnce failed, map not found.");
        return;
    }
    array<Item@> lockers;
    uint count = map.GetItemsByType(ITEM_TYPE_CONTAINER, lockers);

    if(map.GetProtoId() == MAP_ShadyWest)
    {
        if(count == 0)
        {
            Log("No lockers found on Shady Sands West.");
            return;
        }

        Log("shelves found " + count);
       
        // Guard house
        LockerLoot@[] westLocker0;
        westLocker0.insertLast(LockerLoot(PID_223_FMJ, uint(Random(0, 60))));
        ResetLockerLoot(lockers[0], westLocker0);
       
        LockerLoot@[] westLocker1;
        westLocker1.insertLast(LockerLoot(PID_SCOUT_HANDBOOK, 1));
        ResetLockerLoot(lockers[1], westLocker1);

        // Razlo locker
        LockerLoot@[] westLocker2;
        westLocker2.insertLast(LockerLoot(PID_FIRST_AID_BOOK, 1));
        westLocker2.insertLast(LockerLoot(PID_STIMPAK, uint(Random(1, 5))));
        westLocker2.insertLast(LockerLoot(PID_DOCTORS_BAG, 1));
        westLocker2.insertLast(LockerLoot(PID_FIRST_AID_KIT, 1));
        ResetLockerLoot(lockers[2], westLocker2);

        LockerLoot@[] westLocker3;
        westLocker3.insertLast(LockerLoot(PID_BOTTLE_CAPS, uint(Random(1, 50))));
        ResetLockerLoot(lockers[3], westLocker3);
    }
    else if(map.GetProtoId() == MAP_ShadyEast)
    {
        if(count == 0)
        {
            Log("No lockers found on Shady Sands East.");
            return;
        }

        Log("shelves found " + count);
        // Guard house
        LockerLoot@[] westLocker0;
        westLocker0.insertLast(LockerLoot(PID_SCOUT_HANDBOOK, 1));
        westLocker0.insertLast(LockerLoot(PID_ROPE, 1));
        ResetLockerLoot(lockers[0], westLocker0);
    }
}

// Called every hour for respawn items.
void respawnLockers(uint mapPid) {   

    Map@ map = GetMapByPid(mapPid, 0);

    if(!valid(map))
    {
        Log("initLockersOnce failed, map " + mapPid + " not found.");
        return;
    }

    if(map.GetProtoId() == MAP_ShadyEast)
    {
        array<Item@> lockers;
        uint count = map.GetItemsByType(ITEM_TYPE_CONTAINER, lockers);
        if(count == 0)
        {
            Log("No lockers found on Shady Sands West.");
            return;
        }
        Log("shelves found " + count);      
        
        // Guard house
        LockerLoot@[] westLocker0;
        westLocker0.insertLast(LockerLoot(PID_10MM_JHP, uint(Random(1, 60))));
        westLocker0.insertLast(LockerLoot(PID_10MM_AP, uint(Random(1, 60))));
        westLocker0.insertLast(LockerLoot(PID_SPEAR, uint(Random(0, 1))));
        ResetLockerLoot(lockers[0], westLocker0);
        
        // empty house
        LockerLoot@[] westLocker1;
        westLocker1.insertLast(LockerLoot(PID_KNIFE, 1));
        westLocker1.insertLast(LockerLoot(PID_ROCK, 1));
        ResetLockerLoot(lockers[1], westLocker1);

        // Razlo locker
        LockerLoot@[] westLocker2;        
        westLocker2.insertLast(LockerLoot(PID_BOTTLE_CAPS, uint(Random(1, 50))));
        ResetLockerLoot(lockers[2], westLocker2);
        
        // Aradesh house
        LockerLoot@[] westLocker3;  
        westLocker3.insertLast(LockerLoot(PID_FLARE, uint(Random(0, 3))));
        westLocker3.insertLast(LockerLoot(PID_IGUANA_ON_A_STICK, uint(Random(1, 5))));
        if(Chance(15))
            westLocker3.insertLast(LockerLoot(PID_SHOTGUN_SHELLS, uint(Random(1, 50))));
        ResetLockerLoot(lockers[3], westLocker3);

    }
    else if(map.GetProtoId() == MAP_ShadyEast)
    {
        array<Item@> lockers;
        uint count = map.GetItemsByType(ITEM_TYPE_CONTAINER, lockers);
        // Guard house
        LockerLoot@[] eastLocker0;
        eastLocker0.insertLast(LockerLoot(PID_BBS, uint(Random(0, 30))));
        if(Chance(5))
            eastLocker0.insertLast(LockerLoot(PID_SNIPER_RIFLE, 1));
        ResetLockerLoot(lockers[0], eastLocker0);
    }
}

bool ResetLockerLoot(Item@ locker, LockerLoot@[]@ loot)
{
    if(!valid(locker))
        return false;

    // Protected/original loot is still present.
    // Leave the locker completely untouched.
    if(LockerContainsProtected(locker, LOCKER_PROTECTED_ITEMS))
        return false;

    // Remove old respawn loot.
    ClearLocker(locker);

    // Add the complete new loot set.
    for(uint i = 0; i < loot.length(); i++)
    {
        if(loot[i].Count == 0)
            continue;

        locker.AddItem(loot[i].Pid, loot[i].Count, 0);
    }

    return true;
}

// Empty the locker respecting the protected items.
void ClearLocker(Item@ locker)
{
    if(!valid(locker))
        return;
    
    Item@[] items;
    uint count = locker.GetItems(0, items);

    for(uint i = 0; i < count; i++)
    {
        if(valid(items[i]))
            DeleteItem(items[i]);
    }

    if(locker.LockerId != 0)
        locker.LockerCondition = 1;
}

bool Chance(uint percent)
{
    return uint(Random(0, 99)) < percent;
}

bool LockerContainsProtected(Item@ locker, uint[] protectedPids)
{
    if(!valid(locker))
        return false;

    for(uint i = 0; i < protectedPids.length(); i++)
    {
        if(LockerContainsPid(locker, protectedPids[i]))
            return true;
    }

    return false;
}

bool LockerContainsPid(Item@ locker, uint pid)
{
    if(!valid(locker))
        return false;

    Item@[] items;
    uint count = locker.GetItems(0, items);

    for(uint i = 0; i < count; i++)
    {
        if(valid(items[i]) && items[i].GetProtoId() == pid)
            return true;
    }

    return false;
}

// Razlo entrance check
void t_NearEntrance(Critter& critter, Scenery& trigger, bool entered, uint8 dir)
{
    
    if(!critter.IsPlayer())
    {    
        return;
    }

    if(!entered)
    {        
        return;
    }
       
    critter.SendMessage(
        MSG_SANDS_NEAR_ENTRANCE,
        0,
        MESSAGE_TO_VISIBLE_ME
    );

}

void setTandiQuestVal(Critter& player, uint val) {
    GameVar@ questVar = GetLocalVar(
        LVAR_q_shady_tandi,
        player.Id
    );

    if(!valid(questVar))
    {
        Log("setTandiQuestVal: quest variables not found.");
        return;
    }
        
    questVar = val;
    Log("setTandiQuestVal: quest var updated to "+ val);
}

void t_Entered(Critter& critter, Scenery& trigger, bool entered, uint8 dir)
{
    if(!critter.IsPlayer())
    {
        return;
    }

    if(!entered)
    {
        return;
    }

    critter.SendMessage(
        MSG_SANDS_ENTERED,
        0,
        MESSAGE_TO_VISIBLE_ME
    );

}


void s_Dialog(Critter& critter, Scenery& trigger, bool entered, uint8 dir, int dialogId)
{    
    if(!critter.IsPlayer() || !entered)
        return;
        
    RunDialog(critter, dialogId, critter.HexX, critter.HexY, false);
}
