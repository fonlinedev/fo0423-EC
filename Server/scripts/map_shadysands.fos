#define DIALOG_RAZLO_WIFE  (4024)

// items initialized once.
uint[] LOCKER_PROTECTED_ITEMS = { PID_223_FMJ, PID_SCOUT_HANDBOOK, PID_DOCTORS_BAG, PID_FIRST_AID_BOOK, PID_FIRST_AID_KIT };

class LockerLoot
{
    uint Pid;
    uint Count;

    LockerLoot(uint pid, uint count)
    {
        Pid = pid;
        Count = count;
    }
};

void map_init(Map& map, bool firstTime)
{
    uint respawnTime = 1; // 1 hour loop
    uint[] values = { map.GetProtoId() };    
    CreateTimeEvent(__FullSecond + REAL_HOUR(respawnTime), "e_RespawnLoot", values, false);
    if(firstTime)
    {
        map.SetTurnBasedAvailability(true);
        initLockersOnce(map.GetProtoId());
    }
}

uint e_RespawnLoot(uint[]@ values)
{
    if(values is null || values.length() == 0) return 0;
    uint mapId = values[0];
    respawnLockers(mapId);
    return REAL_HOUR(1);
}

// First init the lockers, only run once.
void initLockersOnce(uint mapPid)
{
    Map@ map = GetMapByPid(mapPid, 0);

    if(!valid(map))
    {
        Log("initLockersOnce failed, map " + mapPid + " not found.");
        return;
    }
    array<Item@> lockers;
    uint count = map.GetItemsByType(ITEM_TYPE_CONTAINER, lockers);

    if(map.GetProtoId() == MAP_ShadySandsWest)
    {
        if(count == 0)
        {
            Log("No lockers found on Shady Sands West.");
            return;
        }

        Log("shelves found " + count);
       
        // Guard house
        LockerLoot@[] westLocker0;
        westLocker0.insertLast(LockerLoot(PID_223_FMJ, uint(Random(0, 60))));
        ResetLockerLoot(lockers[0], westLocker0);
       
        LockerLoot@[] westLocker1;
        westLocker1.insertLast(LockerLoot(PID_SCOUT_HANDBOOK, 1));
        ResetLockerLoot(lockers[1], westLocker1);

        // Razlo locker
        LockerLoot@[] westLocker2;
        westLocker2.insertLast(LockerLoot(PID_FIRST_AID_BOOK, 1));
        westLocker2.insertLast(LockerLoot(PID_STIMPAK, uint(Random(1, 5))));
        westLocker2.insertLast(LockerLoot(PID_DOCTORS_BAG, 1));
        westLocker2.insertLast(LockerLoot(PID_FIRST_AID_KIT, 1));
        ResetLockerLoot(lockers[2], westLocker2);

        LockerLoot@[] westLocker3;
        westLocker3.insertLast(LockerLoot(PID_BOTTLE_CAPS, uint(Random(1, 50))));
        ResetLockerLoot(lockers[3], westLocker3);
    }
    else if(map.GetProtoId() == MAP_ShadySandsEast)
    {
        if(count == 0)
        {
            Log("No lockers found on Shady Sands East.");
            return;
        }

        Log("shelves found " + count);
        // Guard house
        LockerLoot@[] westLocker0;
        westLocker0.insertLast(LockerLoot(PID_SCOUT_HANDBOOK, 1));
        westLocker0.insertLast(LockerLoot(PID_ROPE, 1));
        ResetLockerLoot(lockers[0], westLocker0);
    }
}

// Called every hour for respawn items.
void respawnLockers(uint mapPid) {   

    Map@ map = GetMapByPid(mapPid, 0);

    if(!valid(map))
    {
        Log("initLockersOnce failed, map " + mapPid + " not found.");
        return;
    }

    if(map.GetProtoId() == MAP_ShadySandsWest)
    {
        array<Item@> lockers;
        uint count = map.GetItemsByType(ITEM_TYPE_CONTAINER, lockers);
        if(count == 0)
        {
            Log("No lockers found on Shady Sands West.");
            return;
        }
        Log("shelves found " + count);      
        
        // Guard house
        LockerLoot@[] westLocker0;
        westLocker0.insertLast(LockerLoot(PID_10MM_JHP, uint(Random(1, 60))));
        westLocker0.insertLast(LockerLoot(PID_10MM_AP, uint(Random(1, 60))));
        westLocker0.insertLast(LockerLoot(PID_SPEAR, uint(Random(0, 1))));
        ResetLockerLoot(lockers[0], westLocker0);
        
        // empty house
        LockerLoot@[] westLocker1;
        westLocker1.insertLast(LockerLoot(PID_KNIFE, 1));
        westLocker1.insertLast(LockerLoot(PID_ROCK, 1));
        ResetLockerLoot(lockers[1], westLocker1);

        // Razlo locker
        LockerLoot@[] westLocker2;        
        westLocker2.insertLast(LockerLoot(PID_BOTTLE_CAPS, uint(Random(1, 50))));
        ResetLockerLoot(lockers[2], westLocker2);
        
        // Aradesh house
        LockerLoot@[] westLocker3;  
        westLocker3.insertLast(LockerLoot(PID_FLARE, uint(Random(0, 3))));
        westLocker3.insertLast(LockerLoot(PID_IGUANA_ON_A_STICK, uint(Random(1, 5))));
        if(Chance(15))
            westLocker3.insertLast(LockerLoot(PID_SHOTGUN_SHELLS, uint(Random(1, 50))));
        ResetLockerLoot(lockers[3], westLocker3);

    }
    else if(map.GetProtoId() == MAP_ShadySandsEast)
    {
        array<Item@> lockers;
        uint count = map.GetItemsByType(ITEM_TYPE_CONTAINER, lockers);
        // Guard house
        LockerLoot@[] eastLocker0;
        eastLocker0.insertLast(LockerLoot(PID_BBS, uint(Random(0, 30))));
        if(Chance(5))
            eastLocker0.insertLast(LockerLoot(PID_SNIPER_RIFLE, 1));
        ResetLockerLoot(lockers[0], eastLocker0);
    }
}

bool ResetLockerLoot(Item@ locker, LockerLoot@[]@ loot)
{
    if(!valid(locker))
        return false;

    // Protected/original loot is still present.
    // Leave the locker completely untouched.
    if(LockerContainsProtected(locker, LOCKER_PROTECTED_ITEMS))
        return false;

    // Remove old respawn loot.
    ClearLocker(locker);

    // Add the complete new loot set.
    for(uint i = 0; i < loot.length(); i++)
    {
        if(loot[i].Count == 0)
            continue;

        locker.AddItem(loot[i].Pid, loot[i].Count, 0);
    }

    return true;
}

// Empty the locker respecting the protected items.
void ClearLocker(Item@ locker)
{
    if(!valid(locker))
        return;
    
    Item@[] items;
    uint count = locker.GetItems(0, items);

    for(uint i = 0; i < count; i++)
    {
        if(valid(items[i]))
            DeleteItem(items[i]);
    }

    if(locker.LockerId != 0)
        locker.LockerCondition = 1;
}

bool Chance(uint percent)
{
    return Random(0, 99) < percent;
}

bool LockerContainsProtected(Item@ locker, uint[] protectedPids)
{
    if(!valid(locker))
        return false;

    for(uint i = 0; i < protectedPids.length(); i++)
    {
        if(LockerContainsPid(locker, protectedPids[i]))
            return true;
    }

    return false;
}

bool LockerContainsPid(Item@ locker, uint pid)
{
    if(!valid(locker))
        return false;

    Item@[] items;
    uint count = locker.GetItems(0, items);

    for(uint i = 0; i < count; i++)
    {
        if(valid(items[i]) && items[i].GetProtoId() == pid)
            return true;
    }

    return false;
}

// Razlo entrance check
void t_NearEntrance(Critter& critter, Scenery& trigger, bool entered, uint8 dir)
{
    
    if(!critter.IsPlayer())
    {    
        return;
    }

    if(!entered)
    {        
        return;
    }
       
    critter.SendMessage(
        MSG_SANDS_NEAR_ENTRANCE,
        0,
        MESSAGE_TO_VISIBLE_ME
    );

}


void t_Entered(Critter& critter, Scenery& trigger, bool entered, uint8 dir)
{
    if(!critter.IsPlayer())
    {
        return;
    }

    if(!entered)
    {
        return;
    }

    critter.SendMessage(
        MSG_SANDS_ENTERED,
        0,
        MESSAGE_TO_VISIBLE_ME
    );

}


void s_Dialog(Critter& critter, Scenery& trigger, bool entered, uint8 dir, int dialogId)
{    
    if(!critter.IsPlayer() || !entered)
        return;
        
    RunDialog(critter, dialogId, critter.HexX, critter.HexY, false);
}
