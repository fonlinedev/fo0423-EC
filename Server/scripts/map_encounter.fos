import bool   IsCompanion(Critter& follower) from "follower";
#define TRANSFER_RADIUS    (500)
#define GARBAGE_TIMEOUT    (REAL_DAY(7))      // 6 hours for left out cars and stuff

void map_init(Map& map, bool firstTime)
{
    Log("map encounter running");
    if(firstTime)
    {        
       
        // scatter some stuff around
        uint pid = map.GetProtoId();
        uint locpid = map.GetLocation().GetProtoId();
        if(GetMapType(map) == MAP_TYPE_DESERT_ENCOUNTER)
        {
            uint i = Random(0, 7);
            if((i != 1) && (i != 0))                // 25%
            {
                uint[] pids = { PID_PLANT_APPLE_TREE, PID_PLANT_FIBER };
                HideProductionFacility(map, pids, true);
            }
            else
            {
                uint[] pids = { PID_PLANT_APPLE_TREE, PID_PLANT_FIBER };
                ShowProductionFacility(map, pids, true);
            }
            if(i != 2 && !_IsWithinRange(locpid, LOCATION_DesertWater1, LOCATION_DesertWater3))               // 12.5%
            {
                uint[] pids = { PID_TREE1_FIREWOOD, PID_TREE2_FIREWOOD, PID_TREE3_FIREWOOD };
                HideProductionFacility(map, pids, true);
            }
            else
            {
                uint[] pids = { PID_TREE1_FIREWOOD, PID_TREE2_FIREWOOD, PID_TREE3_FIREWOOD };
                ShowProductionFacility(map, pids, true);
            }
            if(i != 3)               // 12.5%
            {
                uint[] pids = { PID_PROD_BROC };
                HideProductionFacility(map, pids, false);
            }
            if(i != 4)               // 12.5%
            {
                uint[] pids = { PID_PROD_XANDER };
                HideProductionFacility(map, pids, true);
            }
            if(i != 5)               // 12.5%
            {
                uint[] pids = { PID_PROD_FLINT };
                HideProductionFacility(map, pids, false);
            }
            // 12.5% if i == 7 (empty encounter)
            // ------------------------------------------------
            // 100% in total
        }
        uint t = GetMapType(map);
        if((t == MAP_TYPE_CITY_ENCOUNTER) || (t == MAP_TYPE_COAST_ENCOUNTER) || (t == MAP_TYPE_SKYSCRAPER_ENCOUNTER))
        {
            uint chance = 19;
            if(t == MAP_TYPE_SKYSCRAPER_ENCOUNTER)
                chance -= 5;
            #ifdef __DEBUG__
            if(true)
            #endif
            #ifndef __DEBUG__
            if((Random(0, chance) == 0))
            #endif
            {
                array<Entire> entires;
                ParseEntires(map, entires, ENTIRE_CAR);
                if(entires.length() > 0)
                {
                    uint  r = Random(0, entires.length() - 1);
                    Item@ car = map.AddItem(entires[r].HexX, entires[r].HexY, PID_WRECKED_CAR, 1);
                }
            }
        }
        // junk junk junk
        if((t == MAP_TYPE_CITY_ENCOUNTER || t == MAP_TYPE_SKYSCRAPER_ENCOUNTER))
        {
            Scatter(map, PID_PUMP_PARTS, "prod_barrel_junk@_Junk");
        }
        // weed
        if((t == MAP_TYPE_DESERT_ENCOUNTER || t == MAP_TYPE_MOUNTAIN_ENCOUNTER))
        {
            uint roll = Random(0, 1);
            switch(roll)
            {
            case 0:
                Scatter(map, PID_XANDER_ROOT, "prod_xander_root@item_init");
                break;
            case 1:
                Scatter(map, PID_BROC_FLOWER, "prod_broc_flower@item_init");
                break;
            }
        }
        if((t == MAP_TYPE_MOUNTAIN_ENCOUNTER))
            Scatter(map, PID_PROD_FLINT, "prod_flint@item_init");
        
    }

    map.SetEvent(MAP_EVENT_FINISH, "_Finish");
    map.SetEvent(MAP_EVENT_IN_CRITTER, "_CritterIn");
    map.SetEvent(MAP_EVENT_CRITTER_DEAD, "_CritterDead");
}

void FillEncounterContainers(Map& map)
{
    array<Item@> containers;
    uint count = map.GetItemsByType(ITEM_TYPE_CONTAINER, containers);

    for(uint i = 0; i < count; i++)
    {
        Item@ container = containers[i];

        if(!valid(container))
            continue;
        
        // Only fill completely empty containers.
        Item@[] contents;
        if(container.GetItems(0, contents) > 0)
            continue;

        // 50% chance that this container remains empty.
        if(Random(0, 1) == 0)
            continue;

        // 1-3 loot items.
        uint lootCount = Random(1, 3);

        for(uint j = 0; j < lootCount; j++)
            AddRandomEncounterLoot(container);
    }
}

void AddRandomEncounterLoot(Item@ container)
{
    uint roll = Random(0, 99);

    // Junk / miscellaneous
    if(roll < 45)
    {
        uint[] junk =
        {            
            
            PID_METAL_PARTS,
            PID_ROPE,            
            PID_BRAHMIN_SKIN,
            PID_FIREGECKO_PELT,
            PID_GECKO_PELT,
            PID_GOLDEN_GECKO_PELT,
            PID_FIREWOOD,
            PID_AXE,
            PID_SHOVEL,
            PID_BOTTLE_EMPTY,
            PID_WATER_FLASK
        };

        uint pid = junk[Random(0, junk.length() - 1)];
        container.AddItem(pid, Random(1, 3), 0);
        return;
    }

    // Medical / consumables
    if(roll < 65)
    {
        uint[] medical =
        {
            PID_STIMPAK,
            PID_FIRST_AID_KIT,
            PID_FIRST_AID_BOOK,
            PID_HEALING_POWDER,
            PID_ANTIDOTE
        };

        uint pid = medical[Random(0, medical.length() - 1)];
        container.AddItem(pid, 1, 0);
        return;
    }

    // Ammo
    if(roll < 85)
    {
        uint[] ammo =
        {
            PID_10MM_JHP,
            PID_10MM_AP,
            PID_223_FMJ,
            PID_SHOTGUN_SHELLS,
            PID_9MM_BALL
        };

        uint pid = ammo[Random(0, ammo.length() - 1)];
        container.AddItem(pid, Random(5, 30), 0);
        return;
    }

    // Low-level weapons
    if(roll < 96)
    {
        uint[] weapons =
        {
            PID_KNIFE,
            PID_CLUB,
            PID_SPEAR,
            PID_10MM_PISTOL,
            PID_GUNS_AND_BULLETS,
            PID_SHOTGUN,
            PID_HUNTING_RIFLE
        };

        uint pid = weapons[Random(0, weapons.length() - 1)];
        container.AddItem(pid, 1, 0);
        return;
    }

    // Rare low-level armor.
    uint[] armor =
    {
        PID_LEATHER_ARMOR,
        PID_METAL_ARMOR,
        PID_LEATHER_JACKET
    };

    uint pid = armor[Random(0, armor.length() - 1)];
    container.AddItem(pid, 1, 0);
}

void ScatterChest(Map& map)
{    
    // Check for active threats.
    array<Critter@> critters;
    uint critterCount = map.GetCritters(0, FIND_ALL | FIND_LIFE, critters);

    uint threats = 0;

    for(uint i = 0; i < critterCount; i++)
    {
        Critter@ cr = critters[i];
        
        if(!valid(cr))
            continue;

        if(!cr.IsNpc())
            continue;

        if(cr.IsDead())
            continue;

        if(IsCompanion(cr))
            continue;

        threats++;
    }

    if(threats == 0)
    {
        return;
    }

    // Check if the map already contains a container.
    array<Item@> containers;
    uint containerCount = map.GetItemsByType(ITEM_TYPE_CONTAINER, containers);

    if(containerCount > 0)
    {
        return;
    }

    // Find a random valid location.
    array<Entire> entires;
    ParseEntires(map, entires, 0);

    if(entires.length() == 0)
    {
        return;
    }

    uint re = Random(0, entires.length() - 1);

    uint16 hx = entires[re].HexX;
    uint16 hy = entires[re].HexY;

    uint dist = Random(20, 100);

    map.GetHexCoord(
        entires[re].HexX,
        entires[re].HexY,
        hx,
        hy,
        Random(0, 359),
        dist
    );

    if(!map.IsHexPassed(hx, hy))
    {
        return;
    }

    uint roll = Random(0, 99);
    if (roll >= 20) {
        Log("roll chest is lower than min " + roll);
        return;
    }

    Item@ chest = map.AddItem(hx, hy, PID_CHEST, 1);

    if(!valid(chest))
    {
        return;
    }

    // Fill the newly created chest.
    FillEncounterContainers(map);
}

//
// Scatters gathering items
//
void Scatter(Map& map, uint16 pid, string@ script)
{

    uint roll = Random(0, 99);

    if (roll >= 33) {
        Log("roll scatter items is lower than min " + roll);
        return;
    }
    array<Entire> entires;
    ParseEntires(map, entires, 0);
    uint          re = Random(0, entires.length() - 1);

    uint16        hx = 0;
    uint16        hy = 0;
    uint          dist = 0;
    while(true)
    {
        hx = entires[re].HexX;
        hy = entires[re].HexY;
        dist = Random(20, 100);
        map.GetHexCoord(entires[re].HexX, entires[re].HexY, hx, hy, Random(0, 359), dist);

        if(map.IsHexPassed(hx, hy) && map.GetSceneries(hx, hy, null) == 0)
            break;
    }

    uint count = dist / 10;
    while(count > 0)
    {
        uint16 x = hx;
        uint16 y = hy;
        map.GetHexCoord(hx, hy, x, y, Random(0, 359), Random(0, 5));
        if(map.GetSceneries(x, y, null) > 0)
            continue;
        uint  n = 1;       // Random(1, count);
        count -= n;
        Item@ it = map.AddItem(x, y, pid, n);
		map.AddItem(x, y, pid, n);
        //if(valid(script))
         //   it.SetScript(script);
    }
}

bool HasCars(Critter& cr, uint locid)
{
    Location@ loc = GetLocation(locid);
    if(!valid(loc))
        return false;
    array<Map@>  maps;
    array<Item@> items;
    for(uint i = 0, j = loc.GetMaps(maps); i < j; i++)
        maps[i].GetItems(0, items);

    for(uint i = 0, j = items.length(); i < j; i++)
        if(items[i].GetType() == ITEM_TYPE_CAR)
        {
            GameVar@ var = GetLocalVar(LIVAR_car_owner_id, items[i].Id);
            if(var.GetValue() == int(cr.Id))
                return true;
        }
    return false;
}

// make player forget this location
void _CritterDead(Map& map, Critter& cr, Critter@)
{
    uint locid = map.GetLocation().Id;
    if(cr.IsPlayer() && cr.IsKnownLoc(true, locid) && !HasCars(cr, locid))
        cr.UnsetKnownLoc(true, locid);
}



void _CritterIn(Map& map, Critter& cr)
{
    // if(cr.IsPlayer() && map.GetLocation().GeckCount > 0)
    //	SetGarbageTimer(map.GetLocation(), GARBAGE_TIMEOUT);
	    
	ScatterChest(map);
    FillEncounterContainers(map);
}

