//
// map_restricted_floor.fos
//

#include "_macros.fos"
#include "factions_h.fos"
#include "messages_h.fos"

void item_init(Item& item, bool firstTime)
{
    // Bind the walk event dynamically using the pattern found in your working scripts
    item.SetEvent(ITEM_EVENT_WALK, "_Walk");
}

void _Walk(Item& item, Critter& critter, bool enter, uint8 dir)
{    
    if(!critter.IsPlayer() || !enter)
        return;

    // Read parameters directly from the mapper's Value0 and Value1 fields
    int factionId = item.Val0;
    int minReputation = item.Val1;
	
    if(critter.ReputationBase[factionId] < minReputation)
    {    
		critter.SendMessage(MSG_ATTACK_ME, 0, MESSAGE_TO_VISIBLE_ME);        
    }
}