const int REPAIRMAN_DIALOG_ID = 4019;
const int REPAIRMAN_WARNING_ID = 1;

// ============================================================================
// GET EQUIPPED ITEMS
// ============================================================================

Item@ GetRepairWeapon1(Critter& player)
{
    Item@ item = player.GetItem(0, SLOT_HAND1);

    if(valid(item) && item.GetType() == ITEM_TYPE_WEAPON)
        return item;
    
    return null;
}

Item@ GetRepairWeapon2(Critter& player)
{
    Item@ item = player.GetItem(0, SLOT_HAND2);

    if(valid(item) && item.GetType() == ITEM_TYPE_WEAPON)
        return item;

    return null;
}

Item@ GetRepairArmor(Critter& player)
{
    Item@ item = player.GetItem(0, SLOT_ARMOR);

    if(valid(item))
        return item;

    return null;
}


Item@ GetRepairHelmet(Critter& player)
{
    Item@ item = player.GetItem(0, SLOT_HEAD);

    if(valid(item))
        return item;

    return null;
}

int GetRepairItemCondition(Item@ item)
{
    if(!valid(item))
        return 0;

    return 50;
}


int GetRepairItemMaxCondition(Item@ item)
{
    if(!valid(item))
        return 0;

    return 100;
}


// ============================================================================
// ITEM FILTER
// ============================================================================
//
// For the prototype everything equipped is repairable.
//
// Later this is where we put:
//
//     - items that cannot be repaired
//     - equipment level restrictions
//     - broken beyond repair
//     - etc.
// ============================================================================

bool IsRepairableItem(Item@ item)
{
    if(!valid(item))
        return false;

    if(IsRepairForbidden(item))
        return false;

    if(FLAG(item.BrokenFlags, BI_NOTRESC))
        return false;

    uint deter = (100 - item.Deterioration * 100 / MAX_DETERIORATION);

    if(deter == 0)
        return false;
    
    return true;
}

bool HasPid(uint16 pid, uint16[]& list)
{
    for(uint i = 0, j = list.length(); i < j; i++)
    {
        if(list[i] == pid)
            return true;
    }

    return false;
}

bool IsRepairCheap(Item@ item)
{
    if(!valid(item))
        return false;

    return HasPid(item.GetProtoId(), REPAIR_CHEAP_ITEMS);
}

bool IsRepairExpensive(Item@ item)
{
    if(!valid(item))
        return false;

    return HasPid(item.GetProtoId(), REPAIR_EXPENSIVE_ITEMS);
}

bool IsRepairForbidden(Item@ item)
{
    if(!valid(item))
        return false;

    return HasPid(item.GetProtoId(), REPAIR_FORBIDDEN_ITEMS);
}

// ============================================================================
// PRICE FOR ONE ITEM
// ============================================================================

int GetRepairItemPrice(Item@ item, Critter& player)
{
    
    if(!IsRepairableItem(item))
        return 0;

    // Free for players below level 10.
    int levelPercent = GetRepairLevelPercent(player);

    if(levelPercent == 0)
        return 0;

    int pricePerPoint = REPAIR_PRICE_NORMAL;

    if(IsRepairCheap(item))
        pricePerPoint = REPAIR_PRICE_CHEAP;
    else if(IsRepairExpensive(item))
        pricePerPoint = REPAIR_PRICE_EXPENSIVE;

    uint deter = (100 - item.Deterioration * 100 / MAX_DETERIORATION);

    if(deter >= 100)
        return 0;

    uint repairAmount = 100 - deter;

    int price = repairAmount * pricePerPoint;

    return (price * levelPercent) / 100;
}

// ============================================================================
// TOTAL REPAIR PRICE
// ============================================================================

#define REPAIR_PRICE \
    #(player) \
    ( \
        GetRepairItemPrice(GetRepairWeapon1(player), player) + \
        GetRepairItemPrice(GetRepairWeapon2(player), player) + \
        GetRepairItemPrice(GetRepairArmor(player), player) + \
        GetRepairItemPrice(GetRepairHelmet(player), player) \
    )


// ============================================================================
// REPAIR PRICE DEMAND
// ============================================================================
//
// This follows the same logic as the doctor's d_HealingMoney.
//
// If the player has enough caps, the dialogue demand succeeds.
// ============================================================================

bool d_RepairMoney(Critter& player, Critter@ npc)
{
    uint price = REPAIR_PRICE(player);

    return _CritCountItem(player, PID_BOTTLE_CAPS) >= price;
}

bool d_NotRepairMoney(Critter& player, Critter@ npc)
{
    return !d_RepairMoney(player, npc);
}

// ============================================================================
// SHOW REPAIR PRICE
// ============================================================================
//
// Example dialogue text:
//
//     "That'll be $price caps."
//
// The lexem gets replaced with the calculated price.
// ============================================================================

void dlg_ShowRepairPrice(Critter& player, Critter@ npc, string@ text)
{
    if(!IS_DIALOG_GENERATED(text))
        return;

    uint price = REPAIR_PRICE(player);

    text = "$price" + price;
}

int GetRepairLevelPercent(Critter& player)
{
    int level = player.Param[ST_LEVEL];
    
    if(level <= 10) {
        return 0;
    }        

    return 100 + ((level - 10) * 10);
}
// ============================================================================
// BASIC "HAS SOMETHING TO REPAIR" DEMAND
// ============================================================================

bool d_HasRepairableEquipment(Critter& player, Critter@ npc)
{
    Item@ item = GetRepairWeapon1(player);

    if(valid(item) && IsRepairableItem(item))
        return true;

    @item = GetRepairWeapon2(player);

    if(valid(item) && IsRepairableItem(item))
        return true;

    @item = GetRepairArmor(player);

    if(valid(item) && IsRepairableItem(item))
        return true;

    @item = GetRepairHelmet(player);

    if(valid(item) && IsRepairableItem(item))
        return true;

    return false;
}

bool d_HasNotRepairableEquipment(Critter& player, Critter@ npc) {
    return (!d_HasRepairableEquipment(player, npc));
}

// ============================================================================
// REPAIR RESULT
// ============================================================================
//
// ============================================================================

void RepairItemClean(Item@ item)
{
    if(!valid(item))
        return;

    item.Deterioration = 0;
    item.BrokenCount = 0;
    UNSETFLAG(item.BrokenFlags, BI_BROKEN);

    item.Update();
}

void r_PayRepair(Critter& player, Critter@ npc)
{
    uint price = REPAIR_PRICE(player);

    if(price <= 0)
        return;

    if(_CritCountItem(player, PID_BOTTLE_CAPS) < price)
        return;

    BanksTransferFromCritter(player, price, TRANSACTION_DEFAULT, false);
}

void r_RepairEquipment(Critter& player, Critter@ npc)
{
    uint price = REPAIR_PRICE(player);

    if(_CritCountItem(player, PID_BOTTLE_CAPS) < price)
        return;

    Item@ item = GetRepairWeapon1(player);

    if(valid(item) && IsRepairableItem(item))
        RepairItemClean(item);

    @item = GetRepairWeapon2(player);

    if(valid(item) && IsRepairableItem(item))
        RepairItemClean(item);

    @item = GetRepairArmor(player);

    if(valid(item) && IsRepairableItem(item))
        RepairItemClean(item);

    @item = GetRepairHelmet(player);

    if(valid(item) && IsRepairableItem(item))
        RepairItemClean(item);
}

void r_ExitWarning(Critter& player, Critter@ npc)
{
    npc.SayMsg(SAY_SHOUT_ON_HEAD, TEXTMSG_DLG, DLGSTR(REPAIRMAN_DIALOG_ID, REPAIRMAN_WARNING_ID));
}