#include "_macros.fos"

// Loot Category Definitions (Set these numbers in the container's Val0 field)
#define CAT_DEFAULT       0  // Mixed baseline city trash
#define CAT_DRUGS         1  // Stimpaks, Buffout, Psycho, Rad-X, Jet
#define CAT_BOOKS         2  // Guns & Bullets, Scout Handbook, Deans Electronics, etc.
#define CAT_CRAFTING      3  // Steel, Firewood, Shovel, Rope, Multi-tool
#define CAT_WEAPONS       4  // Small arms, heavy guns, and specific ammo variants
#define CAT_ARMOR         5  // From Leather Jackets up to Combat/Power Armor
#define CAT_MISC          6  // Caps, Nuka Cola, Lighter, Motion Sensors, electronic bug

// Initialization function assigned to containers in the Mapper
void _InitRespawnContainer(Item& container, bool firstTime)
{
    uint respawnTime = 3600; // 1 hour loop
    uint[] values = { container.Id };
    
    CreateTimeEvent(__FullSecond + REAL_SECOND(respawnTime), "e_RespawnLoot", values, true);
    
    // You just check the value the engine gave you:
    if(firstTime)
    {
        FillContainerWithRandomLoot(container);
        
        if(container.LockerId != 0)
        {
            container.LockerCondition = 1; // Force lock after generating loot
        }
    }
}

// The time loop executed by the engine every 60 minutes
uint e_RespawnLoot(uint[]@ values)
{
    if(values is null || values.length() == 0) return 0;

    uint containerId = values[0];
    Item@ container = GetItem(containerId);
    
    if(valid(container))
    {
        ClearContainer(container);
        FillContainerWithRandomLoot(container);
    }
    
    return 3600;
}

void FillContainerWithRandomLoot(Item& container)
{
    uint category = container.Val0;

    if(category == CAT_DRUGS)
    {
        // --- DRUGS & MEDICAL POOL ---
        if(Random(1, 100) <= 75) container.AddItem(40, Random(1, 4), 0);   // Stimpak
        if(Random(1, 100) <= 40) container.AddItem(144, Random(1, 2), 0);  // Super Stimpak
        if(Random(1, 100) <= 50) container.AddItem(87, Random(1, 2), 0);   // Buffout
        if(Random(1, 100) <= 35) container.AddItem(110, 1, 0);             // Psycho
        if(Random(1, 100) <= 45) container.AddItem(109, Random(1, 3), 0);  // Rad-X
        if(Random(1, 100) <= 60) container.AddItem(259, Random(1, 3), 0);  // Jet
    }
    else if(category == CAT_BOOKS)
    {
        // --- SKILL BOOKS POOL (Can naturally be empty) ---
        if(Random(1, 100) <= 25) container.AddItem(102, 1, 0);             // Guns and Bullets
        if(Random(1, 100) <= 25) container.AddItem(86, 1, 0);              // Scout Handbook
        if(Random(1, 100) <= 20) container.AddItem(76, 1, 0);              // Deans Electronics
        if(Random(1, 100) <= 20) container.AddItem(80, 1, 0);              // First Aid Book
        if(Random(1, 100) <= 15) container.AddItem(73, 1, 0);              // Big Book of Science
    }
    else if(category == CAT_CRAFTING)
    {
        // --- CRAFTING & HARVESTED RESOURCES POOL ---
        // Basic Materials
        if(Random(1, 100) <= 60) container.AddItem(535, Random(2, 6), 0);  // Gunpowder
        if(Random(1, 100) <= 50) container.AddItem(536, Random(3, 8), 0);  // Metal Ore
        if(Random(1, 100) <= 50) container.AddItem(537, Random(3, 8), 0);  // Mineral
        if(Random(1, 100) <= 45) container.AddItem(1801, Random(1, 3), 0); // Electronic Parts
        if(Random(1, 100) <= 55) container.AddItem(1802, Random(2, 5), 0); // Alloys
        if(Random(1, 100) <= 60) container.AddItem(1803, Random(1, 3), 0); // Brahmin Hide
        if(Random(1, 100) <= 55) container.AddItem(1824, Random(3, 7), 0); // Fiber
        
        // Herbal / Flora Ingredients
        if(Random(1, 100) <= 40) container.AddItem(1825, Random(1, 3), 0); // Prod Broc
        if(Random(1, 100) <= 40) container.AddItem(1826, Random(1, 3), 0); // Prod Xander
        if(Random(1, 100) <= 30) container.AddItem(1827, Random(1, 2), 0); // Prod Flint

        // Advanced / Tier 2 Reloaded Crafting Resources
        if(Random(1, 100) <= 25) container.AddItem(9628, Random(1, 3), 0); // Alloys 2
        if(Random(1, 100) <= 35) container.AddItem(9629, Random(1, 4), 0); // Chemicals
        if(Random(1, 100) <= 20) container.AddItem(9630, 1, 0);            // Firegecko Pelt
        if(Random(1, 100) <= 25) container.AddItem(9631, Random(1, 3), 0); // Gunpowder 2
        if(Random(1, 100) <= 30) container.AddItem(9632, Random(2, 5), 0); // Fibre 2
        if(Random(1, 100) <= 20) container.AddItem(9633, Random(1, 4), 0); // Ore 2
        if(Random(1, 100) <= 20) container.AddItem(9634, Random(1, 4), 0); // Minerals 2
		
        
        // Items & Rarities
        if(Random(1, 100) <= 40) container.AddItem(9635, Random(1, 3), 0); // Tobacco
        if(Random(1, 100) <= 15) container.AddItem(572, 1, 0);             // Gold Nugget
        if(Random(1, 100) <= 50) container.AddItem(605, 1, 0);             // Waterbag
    }
    else if(category == CAT_WEAPONS)
    {
        // --- WEAPONS AND AMMUNITION POOL ---
        int weaponRoll = Random(1, 4);
        if(weaponRoll == 1)
        {
            container.AddItem(8, 1, 0);                                    // 10mm Pistol
            container.AddItem(29, Random(2, 5) * 10, 0);                  // 10mm JHP
        }
        else if(weaponRoll == 2)
        {
            container.AddItem(10, 1, 0);                                   // Hunting Rifle
            container.AddItem(34, Random(1, 3) * 10, 0);                  // .223 FMJ
        }
        else if(weaponRoll == 3)
        {
            container.AddItem(94, 1, 0);                                   // Shotgun
            container.AddItem(95, Random(2, 4) * 6, 0);                    // Shotgun Shells
        }
        else if(weaponRoll == 4)
        {
            container.AddItem(23, 1, 0);                                   // Assault Rifle
            container.AddItem(35, Random(3, 5) * 30, 0);                   // 5mm JHP
        }
        
        if(Random(1, 100) <= 15) container.AddItem(15, 1, 0);              // Plasma Rifle
        if(Random(1, 100) <= 10) container.AddItem(12, 1, 0);              // Minigun
    }
    else if(category == CAT_ARMOR)
    {
        // --- APPAREL & ARMOR POOL ---
        int armorRoll = Random(1, 100);
        if(armorRoll <= 40)      container.AddItem(74, 1, 0);              // Leather Jacket
        else if(armorRoll <= 75) container.AddItem(1, 1, 0);               // Leather Armor
        else if(armorRoll <= 92) container.AddItem(2, 1, 0);               // Metal Armor
        else if(armorRoll <= 99) container.AddItem(17, 1, 0);              // Combat Armor
        else                     container.AddItem(3, 1, 0);               // Powered Armor
    }
    else if(category == CAT_MISC)
    {
           // --- MISCELLANEOUS STUFF POOL (UPDATED) ---
        // Original Base Items
        if(Random(1, 100) <= 90) container.AddItem(41, Random(15, 120), 0); // Bottle Caps
        if(Random(1, 100) <= 70) container.AddItem(106, Random(1, 4), 0);  // Nuka Cola
        if(Random(1, 100) <= 60) container.AddItem(101, 1, 0);             // Lighter
        if(Random(1, 100) <= 3) container.AddItem(59, 1, 0);              // Motion Sensor
        if(Random(1, 100) <= 4) container.AddItem(52, 1, 0);              // Geiger Counter
		if(Random(1, 100) <= 15) container.AddItem(1863, 1, 0); 			// Tool 1863
		if(Random(1, 100) <= 18) container.AddItem(20, 1, 0); 			//20     PID_CROWBAR
		if(Random(1, 100) <= 20) container.AddItem(21, 1, 0); 			//21     PID_BRASS_KNUCKLES
		if(Random(1, 100) <= 30) container.AddItem(29, 1, 0); 			//29     PID_10MM_JHP
		if(Random(1, 100) <= 25) container.AddItem(30, 1, 0); 			//30     PID_10MM_AP
		if(Random(1, 100) <= 12) container.AddItem(31, 1, 0); 			//31     PID_44_MAGNUM_JHP
		if(Random(1, 100) <= 16) container.AddItem(34, 1, 0); 			//34     PID_223_FMJ
		if(Random(1, 100) <= 17) container.AddItem(35, 1, 0); 			//35     PID_5MM_JHP
		if(Random(1, 100) <= 8) container.AddItem(36, 1, 0); 			//36     PID_5MM_AP
		if(Random(1, 100) <= 17) container.AddItem(38, 1, 0); 			//38     PID_SMALL_ENERGY_CELL
		if(Random(1, 100) <= 23) container.AddItem(47, 1, 0); 			//47     PID_FIRST_AID_KIT
		if(Random(1, 100) <= 30) container.AddItem(48, 1, 0); 			//48     PID_RADAWAY
		if(Random(1, 100) <= 45) container.AddItem(49, 1, 0); 			//49     PID_ANTIDOTE
		if(Random(1, 100) <= 55) container.AddItem(53, 1, 0); 			//53     PID_MENTATS
		if(Random(1, 100) <= 3) container.AddItem(54, 1, 0); 			//54     PID_STEALTH_BOY

        // Newly Requested Standard Additions
        if(Random(1, 100) <= 45) container.AddItem(40, Random(1, 2), 0);   // Stimpak (ID 40)
        if(Random(1, 100) <= 20) container.AddItem(8, 1, 0);               // 10mm Pistol (ID 8)
        if(Random(1, 100) <= 35) container.AddItem(4, 1, 0);               // Knife (ID 4)
        if(Random(1, 100) <= 25) container.AddItem(74, 1, 0);              // Leather Jacket (ID 74)
        if(Random(1, 100) <= 30) container.AddItem(48, 1, 0);              // RadAway (ID 48)
        if(Random(1, 100) <= 35) container.AddItem(109, 1, 0);             // Rad-X (ID 109)

        // Ultra-Rare 1% Chance Loot Drops
        if(Random(1, 100) <= 1)  container.AddItem(86, 1, 0);              // 1% Chance: Scout Handbook (Book)
        if(Random(1, 100) <= 10)  container.AddItem(537, 1, 0);             // 1% Chance: Mineral (ID 537)
        if(Random(1, 100) <= 10)  container.AddItem(536, 1, 0);             // 1% Chance: Metal Ore (ID 536)
        if(Random(1, 100) <= 20)  container.AddItem(1825, 1, 0);            // 1% Chance: Prod Broc (ID 1825)
        if(Random(1, 100) <= 20)  container.AddItem(1826, 1, 0);            // 1% Chance: Prod Xander (ID 1826)
    }
    else
    {
        // --- DEFAULT MIXED POOL (CAT_DEFAULT) ---
        if(Random(1, 100) <= 50) container.AddItem(40, 1, 0);              // Stimpak
        if(Random(1, 100) <= 40) container.AddItem(29, Random(10, 20), 0); // 10mm Ammo
        if(Random(1, 100) <= 30) container.AddItem(81, 1, 0);              // Iguana on a stick
    }
}

void ClearContainer(Item& container)
{
    // Wipe old inventory items
    Item@[] items;
    uint count = container.GetItems(0, items);
    for(uint i = 0; i < count; i++)
    {
        DeleteItem(items[i]);
    }

    // Force the physical container to re-lock itself during the respawn tick
    // This stops players from picking the lock once and keeping it open forever!
    if(container.LockerId != 0)
    {
        // Sets the item condition flags back to Closed and Locked (Engine state 1)
        container.LockerCondition = 1; 
    }
}
