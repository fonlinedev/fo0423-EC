// ------------------------------------------------------------------
// CONFIGURATION
// ------------------------------------------------------------------
#define MIN_REPUTATION_REQUIRED (100)       // Minimum reputation/faction points needed
#define ALERT_RADIUS            (15)        // Hex distance around the locker to alert guards
#define DEFAULT_MIN_REPUTATION (100)
#define DEFAULT_ALERT_RADIUS   (15)

// ------------------------------------------------------------------
// REPUTATION CHECK HELPER
// ------------------------------------------------------------------
int GetPlayerReputation(Critter& player, uint factionId)
{   
	int rep = player.ParamBase[factionId];
	Log("[FactionLocker] Reading ParamBase[" + (MIN_REPUTATION_REQUIRED + factionId) + "] for Player " + player.Id + " -> Value: " + rep);
    return player.ReputationBase[factionId];
}

// Initialization function assigned to containers in the Mapper
void locker_init(Item& item, bool firstTime)
{
    item.SetEvent(ITEM_EVENT_SKILL, "_lockerSkill");        
    uint[] values = { item.Id };
    
	/*
    CreateTimeEvent(__FullSecond + REAL_SECOND(3600), "e_RespawnLoot", values, true);
	FillContainerWithRandomLoot(item);	
	if(item.LockerId != 0)
	{
		item.LockerCondition = 1; 
	}
	*/
}

// ------------------------------------------------------------------
// MAIN ITEM INTERACTION SCRIPT
// ------------------------------------------------------------------
//
bool _lockerSkill(Item& item, Critter& cr, int skill)
{
    Log("[FactionLocker] TRIGGERED -> Item ID: " + item.Id + " | Critter ID: " + cr.Id + " | Skill: " + skill + " | Val0 (Faction): " + item.Val0 + " | Val1 (MinRep): " + item.Val1);

    // Skill -1 (SKILL_PICK_ON_GROUND) represents opening; SK_LOCKPICK handles lockpicking attempts
    if (skill == SKILL_PICK_ON_GROUND || skill == SK_LOCKPICK)
    {
        uint factionId = item.Val0; // Val0: Faction ID
        int  minRep    = (item.Val1 != 0) ? item.Val1 : DEFAULT_MIN_REPUTATION; // Val1: Required Reputation

        int currentRep = GetPlayerReputation(cr, factionId);

        Log("[FactionLocker] Check -> Current Rep: " + currentRep + " | Required Rep: " + minRep);

        // Check if player/critter lacks sufficient reputation
        if (currentRep < minRep)
        {
            Log("[FactionLocker] ACCESS DENIED -> Alerting guards!");
            cr.Say(SAY_NETMSG, "You do not have permission to open this container!");

            // Trigger nearby guards to attack
            AlertNearbyGuards(item, cr, factionId);

            return true; // Block opening / lockpicking
        }
        else
        {
            Log("[FactionLocker] ACCESS GRANTED -> Critter has enough reputation.");
        }
    }
    else
    {
        Log("[FactionLocker] Ignored skill interaction: " + skill);
    }

    return false; // Allow opening
}
// ------------------------------------------------------------------
// GUARD ALERT SYSTEM
// ------------------------------------------------------------------
void AlertNearbyGuards(Item& locker, Critter& player, uint teamId)
{
    Map@ map = player.GetMap();
    if (!valid(map)) {
		Log("[FactionLocker] ERROR: Player map is invalid!");
		return;
	}   

    array<Critter@> guards;
    // uint count = map.GetCrittersHex(locker.HexX, locker.HexY, DEFAULT_ALERT_RADIUS, FIND_LIFE_AND_KO | FIND_ONLY_NPC, guards);
	uint count = GetNearFactionGuards(GetMap(locker.MapId), locker.HexX, locker.HexY, 10, teamId, guards);
	Log("[FactionLocker] Searching guards near Hex (" + locker.HexX + ", " + locker.HexY + ") with Radius " + DEFAULT_ALERT_RADIUS + " for Faction " + teamId + "...");
	
    for (uint i = 0; i < count; i++)
    {
        Critter@ guard = guards[i];
        if (!valid(guard)) {
			Log("[FactionLocker] Guard index " + i + " is invalid pointer!");
			continue;
		}

        // If teamId is 0, alert all NPCs; otherwise, only alert matching ST_TEAM_ID
        guard.Say(SAY_SHOUT, "Hey! Get away from our supplies!");
		//guard.AddEnemyInStack(player.Id);
		//AddAttackPlane(guard, 0, player);	
    }
}