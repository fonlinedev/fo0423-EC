#include "_macros.fos"
#include "_vars.fos"
#include "_maps.fos"
#include "messages_h.fos"
#include "guard.fos"
#include "factions_h.fos"
#include "npc_roles_h.fos"
#include "ITEMPID.H"
import void NpcSetLevel(Critter& npc, int level) from "parameters";

// -----------------------------------------------------------------------
// Dialog Demands (Conditions)
// -----------------------------------------------------------------------

#define DIALOG_SETH_ID   (4010)
#define STR_COMBAT_TAUNT (4)

// Checks if the player has a weapon equipped in either hand.
bool d_IsArmed(Critter& player, Critter@ npc)
{
    Item@ hand1 = player.GetItem(0, SLOT_HAND1);
    if(valid(hand1) && hand1.GetType() == ITEM_TYPE_WEAPON) return true;

    Item@ hand2 = player.GetItem(0, SLOT_HAND2);
    if(valid(hand2) && hand2.GetType() == ITEM_TYPE_WEAPON) return true;

    return false;
}

// Checks if the player is NOT armed.
bool d_IsNotArmed(Critter& player, Critter@ npc)
{
    return !d_IsArmed(player, npc);
}

// -----------------------------------------------------------------------
// Guard init
// -----------------------------------------------------------------------

void critter_init(Critter& guard, bool firstTime)
{
    guard.SetEvent(CRITTER_EVENT_MESSAGE, "_OnPlayerMessage");    
    GuardInit(guard);
    if(firstTime)
    {
        NpcSetLevel(guard, 10);
        GuardPerks(guard);
    }
}

void _OnPlayerMessage(Critter& npc, Critter& player, int num, int val)
{        
    GuardOnMessage(npc, player, num, val);
    
    if(num == MSG_SANDS_ENTERED)
    {

        int rep = player.ReputationBase[FACTION_NCR];
        bool armed = d_IsArmed(player, npc);
        if(rep < 1000 && armed)
        {
            player.SendMessage(
                MSG_ATTACK_ME,
                0,
                MESSAGE_TO_VISIBLE_ME
            );

            if(npc.Stat[ST_NPC_ROLE] == ROLE_SANDS_GUARD)
            {
                npc.SayMsg(
                    SAY_SHOUT_ON_HEAD,
                    TEXTMSG_DLG,
                    DLGSTR(DIALOG_SETH_ID, STR_COMBAT_TAUNT)
                );
            }
        }
        
        return;
    }
 
}