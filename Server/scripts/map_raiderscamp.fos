enum TandiQuestState
{
    TANDI_NOT_STARTED   = 0,
    TANDI_MISSING       = 1,
    TANDI_SEARCHING     = 2,
    TANDI_FOUND         = 3,
    TANDI_RESCUED       = 4,
    TANDI_COMPLETED     = 5,
    TANDI_DEAD          = 7
